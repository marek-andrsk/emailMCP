# --- Mailboxes ---
# The only source of mailbox definitions. A JSON array of non-secret mailbox
# objects; a quoted multi-line value works here too. Uncomment and fill in.
#
# Fields: key (required, lowercase a-z0-9._-, appears in every message id),
#         address (required), label, host (default imap.migadu.com),
#         port (993), inbox_folder (INBOX), drafts_folder (Drafts),
#         sent_folder (null = discover via the IMAP special-use flag).
#
# MAILBOXES_JSON='[
#   {"key": "example.com", "label": "Example", "address": "me@example.com", "host": "imap.migadu.com"},
#   {"key": "second.example", "address": "me@second.example", "host": "imap.migadu.com"}
# ]'

# One password per mailbox: MAILBOX_<KEY>_PASSWORD, where <KEY> is the mailbox
# key uppercased with non-alphanumeric characters replaced by underscores.
# MAILBOX_EXAMPLE_COM_PASSWORD=imap-password-for-that-mailbox
# MAILBOX_SECOND_EXAMPLE_PASSWORD=imap-password-for-that-mailbox

# --- Server ---
MCP_AUTH_PASSWORD=pick-a-strong-password-for-oauth-approval
BASE_URL=https://your-mcp-server.example.com
MCP_ALLOWED_HOSTS=your-mcp-server.example.com
PORT=8000
